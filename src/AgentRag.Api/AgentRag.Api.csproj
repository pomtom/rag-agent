<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Web API owns EVERYTHING that is not UI:
    upload endpoints, the background ingestion service, the vector database, the chat bot, skills and MCP.
  -->
  <PropertyGroup>
    <!-- Keeps the Foundry / OpenAI API key out of appsettings.json: dotnet user-secrets set "Ai:ApiKey" "..." -->
    <UserSecretsId>a7d3e9c1-5b2f-4e8a-b6d4-2c9f1e7a3b55</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentRag.ServiceDefaults\AgentRag.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI models -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <!-- MCP: client (call other servers' tools) + server (publish our search tool at /mcp) -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- File readers: PDF, Word, Excel -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied next to the dll so the app can read them at run time. -->
    <None Update="Database\schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Skills\**\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
