<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Agent RAG</title>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    @* Interactive Server: pages run on the server; clicks and updates travel over SignalR.
       prerender: false = each page loads its data once (no extra "static" first render). *@
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    private static readonly IComponentRenderMode PageRenderMode = new InteractiveServerRenderMode(prerender: false);
}
